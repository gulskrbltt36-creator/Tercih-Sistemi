  <property name="styleSheet">
   <string notr="true">/* === 1. ARKA PLAN RESMİ === */
QWidget#centralWidget {
    /* Senin ayarladığın yol burası */
    border-image: url(:/UniTercihGUI/images/background.jpg) 0 0 0 0 stretch stretch;
    font-family: 'Segoe UI', sans-serif;
}

/* === 2. BUZLU CAM PANELLER (SOL VE SAĞ KUTULAR) === */
QFrame#solPanel, QFrame#sagPanel {
    /* Yarı saydam beyaz renk */
    background-color: rgba(255, 255, 255, 170); 
    border-radius: 20px; /* Köşeleri yuvarlat */
    border: 1px solid rgba(255, 255, 255, 120); /* Hafif beyaz çizgi */
}

/* === 3. SOLDAKİ LİSTE GÖRÜNÜMÜ === */
QListWidget {
    background-color: transparent; /* Listenin kendi arkası şeffaf olsun */
    border: none;
    outline: none;
}
QListWidget::item {
    color: #444;
    padding: 10px;
    margin: 4px;
    border-radius: 10px;
}
QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 200); /* Üzerine gelince parlasın */
}
QListWidget::item:selected {
    /* Seçilince Mavi-Turkuaz olsun */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a1c4fd, stop:1 #c2e9fb);
    color: white;
}

/* === 4. NORMAL BUTONLAR (Temizle, Ekle vb.) === */

QPushButton {
    background-color: rgba(255, 255, 255, 0.3); /* Yarı saydam beyaz */
    color: #333333; /* Yazı rengi koyu gri (okunabilirlik için) */
    border: 2px solid #ffffff; /* Kalın beyaz çerçeve */
    border-radius: 15px; /* Yuvarlak köşeler */
    padding: 5px;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.5); /* Üzerine gelince biraz daha beyazlaşır */
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.1); /* Tıklanınca şeffaflaşır */
}

/* === 5. SİHİRLİ BÜYÜK BUTON === */
QPushButton#sihirliButon {
    /* Mavi-Yeşilimsi özel renk */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8fd3f4, stop:1 #84fab0);
    border-radius: 30px; /* Tam yuvarlak */
    font-size: 16px;
    padding: 15px 40px;
    border: 2px solid rgba(255,255,255, 0.7);
}
QPushButton#sihirliButon:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #a0e0ff, stop:1 #9dfbc0);
    margin-top: -2px; /* Hafif yukarı zıplama efekti */
}

/* === 6. YAZI KUTULARI (Inputlar) === */
QLineEdit, QComboBox {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid white;
    border-radius: 10px;
    padding: 5px;
    color: #444;
}</string>
