  <property name="styleSheet">
   <string notr="true">/* --- GENEL PENCERE --- */
QDialog {
    /* Diğer ekranlarla aynı pastel geçiş */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #E0F7FA, 
                                stop:0.5 #F3E5F5, 
                                stop:1 #FFF3E0);
}

/* --- YAZI KUTULARI (6 Adet Veri Girişi) --- */
QLineEdit {
    background-color: rgba(255, 255, 255, 180); 
    border: 1px solid rgba(255, 255, 255, 0); 
    border-radius: 15px; 
    padding: 8px 15px;
    font-size: 13px; /* Çok kutu olduğu için yazıyı bir tık küçülttük */
    color: #555555;
}

QLineEdit:focus {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid #b39ddb; 
}

QLineEdit::placeholder {
    color: rgba(80, 80, 80, 150);
    font-style: italic;
}

/* --- BUTONLAR (Kaydet ve Sil) --- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                      stop:0 #f8bbd0, stop:1 #f48fb1);
    color: white;
    font-weight: bold;
    border-radius: 15px;
    padding: 10px 20px;
    font-size: 14px;
    border: none;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                      stop:0 #f48fb1, stop:1 #ec407a);
}

QPushButton:pressed {
    padding-top: 12px;
    padding-left: 21px;
}

/* --- SAĞDAKİ LİSTE (QListWidget veya QTableWidget) --- */
/* Bu kısım o büyük beyaz alanı süsler */
QListWidget, QTableWidget {
    background-color: rgba(255, 255, 255, 150); /* Yarı şeffaf arka plan */
    border: 1px solid rgba(255, 255, 255, 200);
    border-radius: 15px;
    color: #444;
    padding: 10px;
    font-size: 14px;
}

/* Listede bir şeye tıklayınca (Seçili Öğe) */
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #ba68c8; /* Mor/Lila seçim rengi */
    color: white;
    border-radius: 10px; /* Seçili satırın kenarları yuvarlansın */
}

/* Listenin Kaydırma Çubuğu (Scrollbar) - Çok şık dursun */
QScrollBar:vertical {
    border: none;
    background: rgba(0,0,0,0.05);
    width: 8px;
    margin: 0px 0px 0px 0px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #ce93d8;
    min-height: 20px;
    border-radius: 4px;
}</string>
