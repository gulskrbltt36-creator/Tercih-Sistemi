  <property name="styleSheet">
   <string notr="true">/* --- GENEL PENCERE --- */
QDialog {
    /* Kayıt ekranıyla aynı pastel geçiş */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #E0F7FA, 
                                stop:0.5 #F3E5F5, 
                                stop:1 #FFF3E0);
}

/* --- YAZI KUTULARI (Kullanıcı Adı ve Şifre) --- */
QLineEdit {
    background-color: rgba(255, 255, 255, 180); 
    border: 1px solid rgba(255, 255, 255, 0); 
    border-radius: 15px; 
    padding: 8px 15px;
    font-size: 14px;
    color: #555555;
}

QLineEdit:focus {
    background-color: rgba(255, 255, 255, 230);
    border: 1px solid #b39ddb; /* Odaklanınca mor kenarlık */
}

/* Placeholder (Silik Yazı) Rengi */
QLineEdit::placeholder {
    color: rgba(80, 80, 80, 150);
    font-style: italic;
}

/* --- BUTONLAR (Giriş Yap ve Kayıt Ol) --- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                      stop:0 #f8bbd0, stop:1 #f48fb1);
    color: white;
    font-weight: bold;
    border-radius: 15px;
    padding: 10px 20px;
    font-size: 14px;
    border: none;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                      stop:0 #f48fb1, stop:1 #ec407a);
}

QPushButton:pressed {
    padding-top: 12px;
    padding-left: 21px;
}

/* --- BAŞLIK ETİKETİ (Sadece lblBaslik isimliler için) --- */
QLabel#lblBaslik {
    color: #6a1b9a; /* Diğer butonlarla uyumlu koyu bir mor/lila tonu */
    font-family: &quot;Segoe UI&quot;, sans-serif; /* Modern yazı tipi */
    font-size: 28px; /* Yazı boyutu büyük olsun */
    font-weight: bold; /* Kalın yazı */
    background-color: transparent; /* Arka plan şeffaf kalsın */
    margin-bottom: 10px; /* Alttaki kutularla arasına biraz mesafe koyar */
}

/* İsteğe bağlı: Mouse üzerine gelince hafif parlasın istersen */
QLabel#lblBaslik:hover {
    color: #8e24aa; 
}</string>
